# Fastfile for App Icon Maker

default_platform(:ios)

platform :ios do
  
  # Variables
  scheme = "AppIconMaker"
  project = "AppIconMaker.xcodeproj"
  
  desc "Run all tests"
  lane :test do
    run_tests(
      project: project,
      scheme: scheme,
      devices: ["iPhone 15 Pro", "iPad Pro (12.9-inch) (6th generation)"],
      code_coverage: true,
      output_directory: "./fastlane/test_output",
      output_types: "html,junit"
    )
  end
  
  desc "Build the app"
  lane :build do
    build_app(
      project: project,
      scheme: scheme,
      skip_codesigning: true,
      skip_archive: true,
      destination: "generic/platform=iOS Simulator"
    )
  end
  
  desc "Run SwiftLint"
  lane :lint do
    swiftlint(
      mode: :lint,
      config_file: ".swiftlint.yml",
      reporter: "html",
      output_file: "./fastlane/swiftlint-results.html",
      ignore_exit_status: true
    )
  end
  
  desc "Run all quality checks"
  lane :quality do
    lint
    test
  end
  
  desc "Build for release"
  lane :release_build do
    increment_build_number(
      build_number: latest_testflight_build_number + 1
    )
    
    build_app(
      project: project,
      scheme: scheme,
      configuration: "Release",
      export_method: "app-store"
    )
  end
  
  desc "Take screenshots"
  lane :screenshots do
    capture_screenshots(
      scheme: scheme,
      output_directory: "./fastlane/screenshots",
      clear_previous_screenshots: true
    )
  end
  
  desc "Run performance tests"
  lane :performance do
    run_tests(
      project: project,
      scheme: scheme,
      devices: ["iPhone 15 Pro"],
      only_testing: ["AppIconMakerPerformanceTests"],
      code_coverage: false
    )
  end
  
  desc "Generate code coverage report"
  lane :coverage do
    xcov(
      project: project,
      scheme: scheme,
      output_directory: "./fastlane/coverage",
      minimum_coverage_percentage: 50.0
    )
  end
  
  desc "Clean build artifacts"
  lane :clean do
    clear_derived_data
    sh("rm -rf ../build")
    sh("rm -rf ./test_output")
    sh("rm -rf ./screenshots")
    sh("rm -rf ./coverage")
  end
  
  # Error handling
  error do |lane, exception|
    UI.error("Error in lane #{lane}: #{exception.message}")
  end
  
end
